{
  "name": "k-alternatives-benchmark",
  "version": "1.0.0",
  "description": "Comprehensive benchmark suite for k-alternatives meta-heuristic algorithm",
  "main": "scripts/run-all-benchmarks.js",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "benchmark": "node scripts/run-all-benchmarks.js",
    "benchmark:quick": "node scripts/competitive-benchmark.js quick",
    "benchmark:tiny": "node scripts/competitive-benchmark.js tiny",
    "benchmark:standard": "node scripts/competitive-benchmark.js standard",
    "benchmark:thorough": "node scripts/competitive-benchmark.js thorough",
    "benchmark:unified": "node scripts/unified-benchmark.js",
    "benchmark:competitive": "node scripts/competitive-benchmark.js",
    "benchmark:minima": "node scripts/local-minima-analysis.js",
    "stats": "node scripts/tsp-stats.js",
    "test:tsp": "node scripts/benchmark.js small balanced",
    "test:knapsack": "node scripts/knapsack-benchmark-real.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "optimization",
    "tsp",
    "knapsack",
    "pathfinding",
    "meta-heuristic",
    "benchmark"
  ],
  "author": "Mario Raúl Carbonell Martínez",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "vitest": "^4.1.0"
  }
}
